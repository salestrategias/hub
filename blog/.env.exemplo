# Copie este arquivo para blog/.env e preencha (blog/.env está no .gitignore, não sobe pro repo)

# IMPORTANTE: usar o host www (o apex redireciona e derruba o header de autenticação)
WP_URL=https://www.salestrategias.com.br
WP_USER=SEU_USUARIO_WP

# Criar em: WP Admin > Usuários > Perfil > Application Passwords > nome "blog-automacao"
# Cole a senha COM os espaços que o WP mostra (ex: abcd efgh ijkl mnop qrst uvwx)
WP_APP_PASSWORD=

# draft = artigos entram como rascunho pra você aprovar | publish = publica direto
# (os 2 primeiros artigos saem como draft de qualquer forma, pra calibração)
STATUS=publish

# Fotos das capas — chave gratuita em https://www.pexels.com/api/ (licença permite uso comercial sem atribuição)
# Sem a chave, as capas saem na versão tipográfica (sem foto)
# OPCIONAL desde 2026-08-10: as capas passaram a ser gráficos de marca (--modo grafico),
# sem foto de banco. A chave só é usada se alguém rodar o gerador com --busca manualmente.
PEXELS_API_KEY=
