# Copie para .env e preencha. Este arquivo é só o modelo; o .env não vai para o repositório.

# URL /exec da implantação do Apps Script que cuida da agenda.
# Passo a passo em apps-script/README.md.
# Sem esta variável a página /agenda continua funcionando: ela cai no
# WhatsApp com as respostas já formatadas, então nenhum lead se perde.
PUBLIC_AGENDA_ENDPOINT=

# Identificador de medição do Google Analytics 4 (formato G-XXXXXXXXXX).
# O GA só é carregado depois que a pessoa aceita os cookies. Sem esta
# variável, o código de medição nem entra no build.
PUBLIC_GA_ID=
