---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';

const title = 'Serviços da SAL: SEO, Tráfego Pago e Diagnóstico';
const description =
  'Todos os serviços da SAL Estratégias de Marketing: SEO local, SEO para e-commerce, gestão de tráfego pago, diagnóstico de site, conteúdo e criativos.';

const site = 'https://www.salestrategias.com.br';

/* As quatro frentes com página própria. */
const frentes = [
  {
    titulo: 'SEO local',
    href: '/seo-local/',
    icone: 'pin',
    texto: 'Perfil da Empresa no Google, posição no mapa, avaliações e páginas de localidade. Para quem vive de cliente da região: loja de rua, franquia, operação em shopping e rede com várias unidades.',
    para: 'Para varejo local',
  },
  {
    titulo: 'SEO para e-commerce',
    href: '/seo-para-ecommerce/',
    icone: 'busca',
    texto: 'Arquitetura de categorias, página de produto e conteúdo ranqueando para quem já decidiu comprar. Inclui presença nas respostas do ChatGPT, do Gemini e das AI Overviews do Google.',
    para: 'Para loja virtual',
  },
  {
    titulo: 'Gestão de tráfego pago',
    href: '/trafego-pago/',
    icone: 'alvo',
    texto: 'Google Ads e Meta Ads com gestão diária e meta de retorno calculada sobre a sua margem real. Shopping, Performance Max e catálogo para e-commerce; anúncio por raio e medição de visita para loja física.',
    para: 'Para os dois',
  },
  {
    titulo: 'Diagnóstico de site e loja virtual',
    href: '/diagnostico-de-site/',
    icone: 'loja',
    texto: 'Analisamos o seu site como quem vai comprar e mostramos onde a pessoa desiste: página de produto, checkout, frete e velocidade. Você recebe os gargalos apontados e a ordem certa de corrigir.',
    para: 'Porta de entrada',
  },
  {
    titulo: 'Produção de conteúdo',
    href: '/servicos/agencia-de-producao-de-conteudo/',
    icone: 'texto',
    texto: 'Calendário editorial por intenção de busca, artigos otimizados com E-E-A-T e conteúdo para o Perfil da Empresa. É o que faz o SEO andar mês a mês e coloca a sua marca nas respostas das IAs.',
    para: 'Para os dois',
  },
];

/* Frente que entra junto do plano, sem página própria. */
const complementos = [
  {
    id: 'criativos',
    titulo: 'Criativos estratégicos',
    icone: 'camada',
    texto: 'Criativos constantemente atualizados, com o ângulo de venda definido antes da arte e a sua aprovação antes de subir. Anúncio bom não é o mais bonito: é o que fala com a pessoa certa no momento certo.',
    junto: 'Entra junto da gestão de tráfego pago, não é contratado separado.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Serviços da SAL Estratégias de Marketing',
      description,
      url: site + '/servicos/',
      inLanguage: 'pt-BR',
      isPartOf: { '@id': site + '/#site' },
    },
    {
      '@type': 'ItemList',
      itemListElement: frentes.map((f, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: f.titulo,
        url: site + f.href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: site + '/' },
        { '@type': 'ListItem', position: 2, name: 'Serviços', item: site + '/servicos/' },
      ],
    },
  ],
};
---

<Base title={title} description={description} canonical="/servicos/" schema={schema}>
  <Cabecalho />

  <main>
    <!-- ABERTURA -->
    <section class="capa">
      <div class="malha"></div>
      <div class="wrap">
        <nav class="migalhas" aria-label="Você está aqui">
          <a href="/">Início</a> <span aria-hidden="true">/</span> <span>Serviços</span>
        </nav>
        <h1>Tudo o que a SAL faz para a sua loja <em>vender mais</em>.</h1>
        <p class="sub">
          Cinco frentes, montadas na medida do seu negócio.
          Nenhum cliente contrata tudo: o diagnóstico mostra o que faz diferença no seu caso.
        </p>
        <div class="acoes">
          <a class="btn btn-primary" href="/agenda/">Contrate a SAL</a>
          <a class="btn btn-ghost" href="#frentes">Ver as frentes</a>
        </div>
      </div>
    </section>

    <!-- AS QUATRO FRENTES -->
    <section class="sec" id="frentes">
      <div class="wrap">
        <div class="cabeca rev">
          <h2>Cada uma tem página própria, com método e entregáveis.</h2>
        </div>
        <div class="servicos">
          {frentes.map((f) => (
            <a class="servico rev" href={f.href}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {f.icone === 'alvo' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3" /></>}
                {f.icone === 'pin' && <><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></>}
                {f.icone === 'busca' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5M8.5 11h5M11 8.5v5" /></>}
                {f.icone === 'loja' && <><path d="M4 10v10h16V10" /><path d="M3 10 5 4h14l2 6a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0Z" /><path d="M10 20v-6h4v6" /></>}
                {f.icone === 'texto' && <><path d="M5 4h14v16H5z" /><path d="M8.5 9h7M8.5 12.5h7M8.5 16h4" /></>}
              </svg>
              <h3>{f.titulo}</h3>
              <p>{f.texto}</p>
              <span class="vai" aria-hidden="true">Conhecer o serviço →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- AS FRENTES DE APOIO -->
    <section class="sec bone" id="apoio">
      <div class="wrap">
        <div class="cabeca rev">
          <h2>E o criativo, quem faz?</h2>
        </div>
        <div class="publicos">
          {complementos.map((c) => (
            <article class="publico rev" id={c.id}>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
              <p><strong>{c.junto}</strong></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PARA QUEM -->
    <section class="sec sec-sm" id="para-quem">
      <div class="wrap">
        <div class="cabeca rev"><h2 class="h2-menor">Prefere começar pelo seu tipo de negócio?</h2></div>
        <ul class="proximos">
          <li><a href="/varejo-local/">Tenho loja física, quiosque ou rede de lojas <span aria-hidden="true">→</span></a></li>
          <li><a href="/e-commerce/">Tenho e-commerce ou vendo em marketplace <span aria-hidden="true">→</span></a></li>
          <li><a href="/quem-somos/">Quero conhecer a SAL antes <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="band">
      <div class="malha"></div>
      <div class="wrap">
        <h2>Não sabe por qual frente começar?</h2>
        <p class="sub">
          É exatamente para isso que existe o diagnóstico gratuito: a SAL analisa o seu negócio
          e diz onde o marketing rende mais, mesmo que a resposta seja "ainda não é com a gente".
        </p>
        <a class="btn btn-primary" href="/agenda/">Contrate a SAL</a>
      </div>
    </section>
  </main>

  <Rodape />
</Base>
