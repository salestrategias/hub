---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';

const title = 'Agência de SEO e Tráfego Pago para Varejo e E-commerce | SAL';
const description =
  'SEO e tráfego pago na medida certa para loja física e e-commerce. Assessoria em Porto Alegre, atendendo o Brasil todo. Agende um diagnóstico gratuito.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://salestrategias.com.br/#org',
      name: 'SAL Estratégias de Marketing',
      alternateName: 'SAL',
      url: 'https://salestrategias.com.br/',
      slogan: 'Marketing na Medida Certa',
      description: 'Agência de tráfego pago e SEO (tráfego orgânico) para varejo local e e-commerce.',
      foundingDate: '2024',
      founder: {
        '@type': 'Person',
        name: 'Marcelo Freitas',
        jobTitle: 'Estrategista de marketing',
        url: 'https://salestrategias.com.br/marcelo-freitas/',
        sameAs: ['https://www.linkedin.com/in/mcfreitas/', 'https://marcelofreitas.substack.com/'],
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Porto Alegre', addressRegion: 'RS', addressCountry: 'BR' },
      telephone: '+55-51-99338-0278',
      email: 'contato@salestrategias.com.br',
      areaServed: { '@type': 'Country', name: 'Brasil' },
      availableLanguage: 'pt-BR',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'comercial',
        telephone: '+55-51-99338-0278',
        email: 'contato@salestrategias.com.br',
        areaServed: 'BR',
        availableLanguage: 'pt-BR',
      },
      knowsAbout: ['Tráfego pago', 'Google Ads', 'Meta Ads', 'SEO', 'Tráfego orgânico', 'SEO local', 'Google Meu Negócio', 'E-commerce', 'Varejo'],
      sameAs: ['https://www.instagram.com/salestrategias/', 'https://marcelofreitas.substack.com/'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://salestrategias.com.br/#site',
      name: 'SAL Estratégias de Marketing',
      url: 'https://salestrategias.com.br/',
      inLanguage: 'pt-BR',
      publisher: { '@id': 'https://salestrategias.com.br/#org' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Qual a diferença entre tráfego pago e tráfego orgânico?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Tráfego pago é quando você paga por clique ou impressão, no Google Ads e no Meta Ads: liga hoje, traz visita hoje, e para quando a verba acaba. Tráfego orgânico vem do SEO, das buscas, do mapa e das respostas das IAs: demora mais pra engrenar e não some quando você para de investir. Os dois se completam, e o que muda de loja pra loja é a dose de cada um.',
          },
        },
        {
          '@type': 'Question',
          name: 'Quanto preciso investir em anúncios para começar?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Para e-commerce, trabalhamos com quem tem pelo menos R$ 2.500 por mês para investir em anúncios. Para loja física, a partir de R$ 1.500. Abaixo disso a campanha não reúne dado suficiente para otimizar e o dinheiro rende mais em outra frente, normalmente no SEO local. Se for o seu caso, dizemos isso no diagnóstico.',
          },
        },
        {
          '@type': 'Question',
          name: 'Em quanto tempo aparece resultado?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Anúncio responde nas primeiras semanas, com o mês inicial servindo para calibrar público e criativo. Em SEO o próprio Google avisa que leva de quatro meses a um ano. Na nossa experiência os primeiros sinais vêm por volta de 90 dias, e é por isso que o contrato é de 6 meses: abaixo disso você paga o esforço e não colhe o resultado.',
          },
        },
        {
          '@type': 'Question',
          name: 'Vocês atendem loja física ou só e-commerce?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'As duas. Metade do trabalho é com loja física, quiosque, franquia e operação em shopping, onde o objetivo é fluxo na porta. A outra metade é e-commerce. Quem tem os dois canais recebe um plano que cobre os dois.',
          },
        },
        {
          '@type': 'Question',
          name: 'Vocês atendem rede com várias lojas?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sim, e é um trabalho que a SAL organizou como serviço próprio. Cada unidade tem o seu Perfil da Empresa no Google, a sua página de localidade, as suas avaliações e a sua campanha por raio, com um painel que compara as lojas entre si. Rede, franquia e operação de shopping entram por aqui.',
          },
        },
        {
          '@type': 'Question',
          name: 'Como funciona o relatório e a reunião mensal?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Todo mês você recebe um documento com o que foi investido, o que voltou, o que o orgânico trouxe e o que muda no mês seguinte. Depois sentamos pra ler os números juntos e decidir o próximo passo. Sem PDF de quarenta páginas e sem gráfico que ninguém explica.',
          },
        },
        {
          '@type': 'Question',
          name: 'Tem fidelidade no contrato?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'O contrato é de 6 meses, que é o tempo mínimo para o SEO dar resultado. Mas você pode cancelar quando quiser, sem multa, avisando com 30 dias de antecedência. O prazo existe para proteger o trabalho, não para prender você.',
          },
        },
      ],
    },
  ],
};

const servicos = [
  {
    titulo: 'SEO local',
    texto: 'Perfil da Empresa no Google, mapa e busca de bairro. Quem pesquisa "perto de mim" precisa achar a sua loja antes de achar a do vizinho. Em rede, cada unidade tem o seu.',
    icone: 'pin',
  },
  {
    titulo: 'SEO para e-commerce',
    texto: 'Categoria, produto e conteúdo ranqueando para quem já está decidido a comprar. Inclui o trabalho para a sua marca ser citada nas respostas do ChatGPT, do Gemini e do Google.',
    icone: 'busca',
  },
  {
    titulo: 'Tráfego pago',
    texto: 'Google Ads e Meta Ads com gestão diária e meta de retorno calculada sobre a sua margem. Em loja física, anúncio por raio e medição de visita, não só de clique.',
    icone: 'alvo',
  },
  {
    titulo: 'Diagnóstico de site e loja virtual',
    texto: 'Nós analisamos o seu site como quem vai comprar: onde a pessoa trava, o que falta na página de produto, o que atrapalha no checkout e o que derruba a velocidade. Você recebe os gargalos apontados e a ordem de corrigir.',
    icone: 'loja',
  },
  {
    titulo: 'Conteúdo e autoridade',
    texto: 'Calendário editorial montado por intenção de busca, artigos otimizados e conteúdo para o Perfil da Empresa. É o que faz o SEO andar mês a mês.',
    icone: 'texto',
  },
  {
    titulo: 'Criativos estratégicos',
    texto: 'Criativos constantemente atualizados, com o ângulo de venda definido antes da arte e aprovação sua antes de subir. Entram junto do plano de mídia.',
    icone: 'camada',
  },
];

/* -------------------------------------------------------------------------
   Últimos artigos do Blog da SAL, lidos da API do WordPress em tempo de build.
   Se a API estiver fora do ar na hora do build, a home simplesmente não
   mostra os blocos de blog — nunca quebra a publicação.
   O bloco do topo ainda se atualiza sozinho no navegador (ver Base.astro),
   para não depender de um rebuild a cada post novo.
------------------------------------------------------------------------- */
const API_BLOG = 'https://www.salestrategias.com.br/wp-json/wp/v2/posts?per_page=4&_embed=wp:featuredmedia,wp:term';

const semTags = (s = '') => s.replace(/<[^>]*>/g, '').replace(/&hellip;/g, '…').replace(/&#8230;/g, '…').replace(/&nbsp;/g, ' ').replace(/&#8217;/g, '’').replace(/&amp;/g, '&').trim();

let artigos = [];
try {
  const r = await fetch(API_BLOG);
  if (r.ok) {
    artigos = (await r.json()).map((p) => {
      const emb = p._embedded ?? {};
      return {
        titulo: semTags(p.title?.rendered),
        resumo: semTags(p.excerpt?.rendered).slice(0, 150),
        link: p.link,
        data: p.date,
        categoria: (emb['wp:term'] ?? []).flat().find((t) => t?.taxonomy === 'category')?.name ?? 'Blog',
        imagem: (emb['wp:featuredmedia'] ?? [])[0]?.source_url ?? null,
      };
    });
  }
} catch {
  artigos = [];
}

const dataBR = (iso) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'America/Sao_Paulo' }).format(new Date(iso));

const destaque = artigos[0] ?? null;
const maisArtigos = artigos.slice(1, 4);

const territorios = [
  {
    n: '01',
    titulo: 'Ser encontrado',
    texto: 'SEO local, SEO de e-commerce, Perfil da Empresa no Google, presença nas respostas das IAs e anúncio na hora da busca. Antes de convencer alguém, é preciso aparecer para essa pessoa.',
  },
  {
    n: '02',
    titulo: 'Ser escolhido',
    texto: 'Página de produto, checkout, oferta, avaliações e criativo. Quem chega até você compara com outros três antes de decidir, e o que decide é o que está na tela nesses segundos.',
  },
  {
    n: '03',
    titulo: 'Ser lembrado',
    texto: 'Base de clientes, WhatsApp, recompra e sazonalidade. Cliente que comprou uma vez e nunca mais ouviu falar de você custou caro duas vezes.',
  },
];
---

<Base title={title} description={description} canonical="/" schema={schema}>

  <Cabecalho />

  <main>

    <!-- HERO -->
    <section class="hero">
      <img
        class="hero-foto"
        src="/img/fotos/vitrines-noite.jpg"
        alt="Vitrines iluminadas de lojas à noite em uma rua de compras"
        width="1280" height="853" fetchpriority="high" decoding="async"
      />
      <div class="hero-veu" aria-hidden="true"></div>
      <div class="malha"></div>
      <div class="wrap">
        <div>
          <span class="eyebrow">Assessoria de SEO e tráfego pago</span>
          <h1>Sua loja encontrada por <em>quem já quer comprar</em>.</h1>
          <p class="sub">
            Para loja física e e-commerce. Você aparece na hora em que a pessoa procura o que você
            vende: no Google, no mapa e no anúncio.
          </p>
          <div class="acoes">
            <a class="btn btn-primary" href="/agenda/">Agendar diagnóstico ↗</a>
            <a class="btn btn-ghost" href="#metodo">Ver como trabalhamos</a>
          </div>
          <p class="porta"><a class="link-side" href="/e-commerce/">Tem e-commerce? Comece por aqui →</a></p>
        </div>
      </div>
    </section>

    <!-- ESTA SEMANA NO BLOG (atualiza sozinho no navegador) -->
    {destaque && (
      <section class="wrap">
        <a class="agora" href={destaque.link} data-blog-destaque>
          <span class="agora-rot">
            <span class="pulso" aria-hidden="true"></span>
            Esta semana no Blog da SAL
          </span>
          <span class="agora-titulo" data-campo="titulo">{destaque.titulo}</span>
          <span class="agora-meta">
            <span data-campo="categoria">{destaque.categoria}</span>
            <span aria-hidden="true">·</span>
            <time data-campo="data" datetime={destaque.data}>{dataBR(destaque.data)}</time>
          </span>
          <span class="agora-vai" aria-hidden="true">Ler o artigo →</span>
        </a>
      </section>
    )}

    <!-- PARA QUEM -->
    <section class="sec" id="para-quem">
      <div class="wrap">
        <div class="cabeca rev">
          <span class="eyebrow">Para quem</span>
          <h2>Dois negócios, duas engrenagens diferentes.</h2>
          <p>Loja de rua e loja online não vendem do mesmo jeito, e o marketing das duas não pode ser o mesmo. A SAL trabalha as duas, com a dose que cada uma pede.</p>
        </div>
        <div class="publicos">
          <article class="publico fisico rev">
            <h3>Varejo local</h3>
            <p>Loja de rua, quiosque, franquia, operação em shopping e rede com várias unidades. O que importa é o cliente encontrar sua loja, ser bem atendido e virar freguês.</p>
            <ul>
              <li>Perfil da Empresa no Google no topo do mapa</li>
              <li>Anúncio por raio, só para quem consegue chegar</li>
              <li>Avaliações respondidas e reputação cuidada</li>
              <li>Rede: cada loja com o seu perfil, sua página e seu painel</li>
            </ul>
            <a class="vai" href="/varejo-local/">Ver a frente de varejo local →</a>
          </article>
          <article class="publico online rev">
            <h3>E-commerce</h3>
            <p>Loja virtual que precisa crescer com margem, e não só aumentar o número de pedidos.</p>
            <ul>
              <li>Shopping, Performance Max e catálogo bem configurados</li>
              <li>Meta de retorno calculada sobre comissão, frete e imposto</li>
              <li>Produto e categoria ranqueando sem pagar por clique</li>
              <li>Sua marca citada nas respostas do ChatGPT e do Gemini</li>
            </ul>
            <a class="vai" href="/e-commerce/">Ver a frente de e-commerce →</a>
          </article>
        </div>
      </div>
    </section>

    <!-- SERVIÇOS -->
    <section class="sec" id="servicos">
      <div class="wrap">
        <div class="cabeca rev">
          <span class="eyebrow">Nossos serviços</span>
          <h2>O que a SAL entrega, na prática.</h2>
        </div>
        <div class="servicos">
          {servicos.map((s) => (
            <article class="servico rev">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {s.icone === 'alvo' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3" /></>}
                {s.icone === 'pin' && <><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></>}
                {s.icone === 'busca' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5M8.5 11h5M11 8.5v5" /></>}
                {s.icone === 'camada' && <><path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 13 9 5 9-5" /></>}
                {s.icone === 'loja' && <><path d="M4 10v10h16V10" /><path d="M3 10 5 4h14l2 6a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0Z" /><path d="M10 20v-6h4v6" /></>}
                {s.icone === 'texto' && <><path d="M5 4h14v16H5z" /><path d="M8.5 9h7M8.5 12.5h7M8.5 16h4" /></>}
                {s.icone === 'grafico' && <><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></>}
              </svg>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- MÉTODO -->
    <section class="sec" id="metodo">
      <div class="wrap">
        <div class="cabeca rev">
          <span class="eyebrow">Marketing na Medida Certa</span>
          <h2>Método baseado em dados.</h2>
          <p>
            Sal demais estraga o prato, de menos ninguém sente o gosto. Com verba de marketing é igual.
            A dose certa vem dos seus números: ticket, margem, sazonalidade e o que a concorrência está
            fazendo. É isso que a gente define antes de começar a gastar.
          </p>
        </div>
        <div class="metodo">
          <div class="passo rev"><b>01</b><h3>Descobrir</h3><p>Auditoria das contas de anúncio, da presença no mapa, do site e de três concorrentes seus. No fim, um documento com os gargalos e a ordem de atacar.</p></div>
          <div class="passo rev"><b>02</b><h3>Desenhar</h3><p>Verba, canais, metas e calendário definidos antes de qualquer campanha ir para o ar, com base no seu ticket e na sua margem.</p></div>
          <div class="passo rev"><b>03</b><h3>Disparar</h3><p>Gestão diária das campanhas, criativo novo toda semana e o SEO avançando mês a mês, com ajuste enquanto roda.</p></div>
          <div class="passo rev"><b>04</b><h3>Decodificar</h3><p>Reunião mensal lendo os números juntos. Canal que não se paga sai do plano no mês seguinte.</p></div>
        </div>
      </div>
    </section>

    <!-- 3 TERRITÓRIOS -->
    <section class="sec" id="territorios">
      <div class="wrap">
        <div class="cabeca rev">
          <span class="eyebrow">Onde a SAL atua</span>
          <h2>Os três territórios da venda.</h2>
          <p>
            Toda venda, na loja de rua ou no e-commerce, passa por três momentos. A maior parte das
            agências trabalha só o primeiro. É no segundo e no terceiro que costuma estar o dinheiro
            que a sua operação já poderia estar fazendo.
          </p>
        </div>
        <div class="territorios">
          {territorios.map((t) => (
            <article class="territorio rev">
              <b>{t.n}</b>
              <h3>{t.titulo}</h3>
              <p>{t.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOG DA SAL -->
    {maisArtigos.length > 0 && (
      <section class="sec" id="blog">
        <div class="wrap">
          <div class="cabeca-linha rev">
            <div>
              <span class="eyebrow">Blog da SAL</span>
              <h2>O que a gente anda escrevendo.</h2>
            </div>
            <a class="btn btn-ghost" href="/blog/">Ver todos os artigos ↗</a>
          </div>
          <div class="artigos">
            {maisArtigos.map((a) => (
              <article class="artigo rev">
                <a href={a.link}>
                  <figure>
                    {a.imagem
                      ? <img src={a.imagem} alt={a.titulo} loading="lazy" decoding="async" width="640" height="360" />
                      : <span class="sem-capa" aria-hidden="true"></span>}
                  </figure>
                  <span class="artigo-cat">{a.categoria}</span>
                  <h3>{a.titulo}</h3>
                  <p>{a.resumo}…</p>
                  <time datetime={a.data}>{dataBR(a.data)}</time>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SOBRE (seção osso: a quebra editorial) -->
    <section class="sec bone" id="sobre">
      <div class="wrap">
        <div class="fundador">
          <div class="rev">
            <figure class="foto-grande">
              <img src="/img/fotos/marcelo-palestra.jpg" alt="Marcelo Freitas falando em um evento de marketing" width="900" height="1125" loading="lazy" decoding="async" />
            </figure>
            <div class="mini-fotos">
              <figure><img src="/img/fotos/starbucks-inauguracao.jpg" alt="Corte de fita na inauguração da primeira Starbucks de Porto Alegre" width="800" height="533" loading="lazy" decoding="async" /></figure>
              <figure><img src="/img/fotos/pascoa-gramado.jpg" alt="Natal Luz de Gramado, com personagens em frente ao letreiro da cidade" width="800" height="600" loading="lazy" decoding="async" /></figure>
              <figure><img src="/img/fotos/marcelo-evento-1.jpg" alt="Marcelo Freitas em um evento do setor de shopping centers" width="800" height="533" loading="lazy" decoding="async" /></figure>
            </div>
          </div>
          <div class="rev">
            <span class="eyebrow">Quem está por trás</span>
            <h2>12 anos como estrategista de marketing, estudando a fundo o comportamento dos clientes.</h2>
            <p>
              Marcelo Freitas atua com marketing e comunicação desde 2014. Antes disso, trabalhou com TI,
              análise de sistemas e criação de sites, base técnica que ainda hoje se reflete no trabalho
              da SAL.
            </p>
            <p>
              Foi gestor de marketing de uma instituição de ensino, responsável por tráfego pago, produção
              de aulas, gestão de portais e tecnologia. Por cinco anos, atuou como gerente de marketing de
              uma administradora de shopping centers, conduzindo tenant mix, captação de lojas, produção de
              eventos e gestão de marcas.
            </p>
            <p>
              Coordenou o marketing do Vita Boulevard Gramado desde o lançamento, com expansão comercial de
              mais de 40 marcas (Kopenhagen, Hering, Panvel, Belshop, Intimissimi, Calzedonia, Tip Top,
              Grand Cru, entre outras) e ações em parceria com o Festival de Cinema de Gramado, Páscoa,
              Natal Luz e programação musical. Pela administradora, atendeu também marcas como Unimed,
              Cacau Show, Natura, Beagle e McDonald&rsquo;s.
            </p>
            <p class="destaque">Em 2024, fundou a SAL.</p>
            <p><a class="btn btn-ghost" href="/quem-somos/">Conhecer a SAL ↗</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec" id="duvidas">
      <div class="wrap">
        <div class="faq">
          <div class="rev">
            <span class="eyebrow">Perguntas frequentes</span>
            <h2>Ficou alguma dúvida?</h2>
            <p style="color:var(--muted)">Se a sua não estiver aqui, chame no WhatsApp que respondemos.</p>
            <a class="btn btn-ghost" href="https://wa.me/5551993380278" rel="noopener">Perguntar no WhatsApp</a>
          </div>
          <div class="rev">
            <details>
              <summary>Qual a diferença entre tráfego pago e tráfego orgânico?</summary>
              <div><p>Tráfego pago é quando você paga por clique ou impressão, no Google Ads e no Meta Ads: liga hoje, traz visita hoje, e para quando a verba acaba. Tráfego orgânico vem do SEO, das buscas, do mapa e das respostas das IAs: demora mais pra engrenar e não some quando você para de investir. Os dois se completam, e o que muda de loja pra loja é a dose de cada um.</p></div>
            </details>
            <details>
              <summary>Quanto preciso investir em anúncios para começar?</summary>
              <div><p>Para e-commerce, trabalhamos com quem tem pelo menos R$ 2.500 por mês para investir em anúncios. Para loja física, a partir de R$ 1.500. Abaixo disso a campanha não reúne dado suficiente para otimizar e o dinheiro rende mais em outra frente, normalmente no SEO local. Se for o seu caso, a gente diz isso no diagnóstico.</p></div>
            </details>
            <details>
              <summary>Em quanto tempo aparece resultado?</summary>
              <div><p>Anúncio responde nas primeiras semanas, com o mês inicial servindo para calibrar público e criativo. Em SEO o próprio Google avisa que leva de quatro meses a um ano. Na nossa experiência os primeiros sinais vêm por volta de 90 dias, e é por isso que o contrato é de 6 meses: abaixo disso você paga o esforço e não colhe o resultado. Quem promete primeira página em 30 dias está vendendo o que não pode entregar.</p></div>
            </details>
            <details>
              <summary>Vocês atendem loja física ou só e-commerce?</summary>
              <div><p>As duas. Metade do trabalho é com loja física, quiosque, franquia e operação em shopping, onde o objetivo é fluxo na porta. A outra metade é e-commerce. Quem tem os dois canais recebe um plano que cobre os dois.</p></div>
            </details>
            <details>
              <summary>Vocês atendem rede com várias lojas?</summary>
              <div><p>Sim, e é um trabalho que a SAL organizou como serviço próprio. Cada unidade tem o seu Perfil da Empresa no Google, a sua página de localidade, as suas avaliações e a sua campanha por raio, com um painel que compara as lojas entre si. Rede, franquia e operação de shopping entram por aqui.</p></div>
            </details>
            <details>
              <summary>Como funciona o relatório e a reunião mensal?</summary>
              <div><p>Todo mês você recebe um documento com o que foi investido, o que voltou, o que o orgânico trouxe e o que muda no mês seguinte. Depois sentamos pra ler os números juntos e decidir o próximo passo. Sem PDF de quarenta páginas e sem gráfico que ninguém explica.</p></div>
            </details>
            <details>
              <summary>Tem fidelidade no contrato?</summary>
              <div><p>O contrato é de 6 meses, que é o tempo mínimo para o SEO dar resultado. Mas você pode cancelar quando quiser, sem multa, avisando com 30 dias de antecedência. O prazo existe para proteger o trabalho, não para prender você.</p></div>
            </details>
          </div>
