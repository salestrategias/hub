---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';

const title = 'Marcelo Freitas, fundador da SAL Estratégias de Marketing';
const description =
  'Estrategista de marketing desde 2014, com cinco anos como gerente de marketing de uma administradora de shopping centers. Em 2024, fundou a SAL.';

const site = 'https://salestrategias.com.br';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': site + '/marcelo-freitas/#pessoa',
      name: 'Marcelo Freitas',
      jobTitle: 'Estrategista de marketing e fundador da SAL',
      description,
      url: site + '/marcelo-freitas/',
      nationality: { '@type': 'Country', name: 'Brasil' },
      homeLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Porto Alegre', addressRegion: 'RS', addressCountry: 'BR' } },
      knowsAbout: ['Marketing de varejo', 'Shopping center', 'Tráfego pago', 'SEO local', 'E-commerce', 'Tenant mix'],
      sameAs: ['https://www.linkedin.com/in/marcelocfreitas/', 'https://marcelofreitas.substack.com/', 'https://www.instagram.com/marcelo.c.freitas/'],
      worksFor: { '@type': 'Organization', name: 'SAL Estratégias de Marketing', url: site + '/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: site + '/' },
        { '@type': 'ListItem', position: 2, name: 'Marcelo Freitas', item: site + '/marcelo-freitas/' },
      ],
    },
  ],
};

const redes = [
  { rot: 'LinkedIn', href: 'https://www.linkedin.com/in/marcelocfreitas/' },
  { rot: 'Substack', href: 'https://marcelofreitas.substack.com/' },
  { rot: 'Instagram', href: 'https://www.instagram.com/marcelo.c.freitas/' },
];
---

<Base title={title} description={description} canonical="/marcelo-freitas/" schema={schema}>
  <Cabecalho />

  <main>
    <section class="capa">
      <div class="malha"></div>
      <div class="wrap">
        <nav class="migalhas" aria-label="Você está aqui">
          <a href="/">Início</a> <span aria-hidden="true">/</span> <span>Marcelo Freitas</span>
        </nav>
        <div class="perfil">
          <div>
            <span class="eyebrow">Quem fundou a SAL</span>
            <h1>Marcelo Freitas, <em>fundador da SAL</em>.</h1>
            <p class="sub">
              Estrategista de marketing há 12 anos. Cinco deles dentro do universo de shopping center,
              respondendo pelo movimento de dezenas de lojas ao mesmo tempo.
            </p>
            <ul class="redes-lista">
              {redes.map((r) => <li><a class="link-side" href={r.href} rel="noopener">{r.rot} ↗</a></li>)}
            </ul>
          </div>
          <figure class="perfil-foto">
            <img src="/img/fotos/marcelo-palestra.jpg" alt="Marcelo Freitas falando em um evento de marketing" width="900" height="1125" fetchpriority="high" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <article class="texto-longo rev">
          <p class="corpo">
            Atua com marketing e comunicação desde 2014. Antes disso, trabalhou com TI, análise de
            sistemas e criação de sites, base técnica que ainda hoje se reflete no trabalho da SAL.
          </p>
          <p class="corpo">
            Foi gestor de marketing de uma instituição de ensino, responsável por tráfego pago,
            produção de aulas, gestão de portais e tecnologia. Por cinco anos, atuou como gerente de
            marketing de uma administradora de shopping centers, conduzindo tenant mix, captação de
            lojas, produção de eventos e gestão de marcas.
          </p>
          <p class="corpo">
            Coordenou o marketing do Vita Boulevard Gramado desde o lançamento, com expansão comercial
            de mais de 40 marcas (Kopenhagen, Hering, Panvel, Belshop, Intimissimi, Calzedonia, Tip Top,
            Grand Cru, entre outras) e ações em parceria com o Festival de Cinema de Gramado, Páscoa,
            Natal Luz e programação musical. Pela administradora, atendeu também marcas como Unimed,
            Cacau Show, Natura, Beagle e McDonald&rsquo;s.
          </p>
          <p class="corpo destaque-linha">Em 2024, fundou a SAL.</p>
        </article>

        <div class="galeria rev">
          <figure>
            <img src="/img/fotos/starbucks-inauguracao.jpg" alt="Corte de fita na inauguração da primeira Starbucks de Porto Alegre" width="800" height="533" loading="lazy" decoding="async" />
            <figcaption>Inauguração da primeira Starbucks de Porto Alegre, na Galeria Chaves Barcellos.</figcaption>
          </figure>
          <figure>
            <img src="/img/fotos/natal-luz-gramado.jpg" alt="Natal Luz de Gramado, com personagens em frente ao letreiro da cidade" width="800" height="600" loading="lazy" decoding="async" />
            <figcaption>Natal Luz, em Gramado: alta temporada é onde o varejo mostra o que sabe.</figcaption>
          </figure>
          <figure>
            <img src="/img/fotos/marcelo-evento-1.jpg" alt="Marcelo Freitas em um evento do setor de shopping centers" width="800" height="533" loading="lazy" decoding="async" />
            <figcaption>Evento do setor de shopping centers.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec bone">
      <div class="wrap">
        <div class="cabeca rev">
          <span class="eyebrow">Fora do trabalho</span>
          <h2>Cinema, audiovisual e uma certa mania de estudar comportamento.</h2>
        </div>
        <div class="dupla">
          <div class="rev">
            <p class="corpo">
              Apaixonado por cinema e audiovisual, o que ajuda mais do que parece em marketing: contar
              história, entender ritmo e saber o que prende alguém nos primeiros segundos é o mesmo
              ofício, em escalas diferentes.
            </p>
          </div>
          <div class="rev">
            <p class="corpo">
              Escreve sobre varejo, marketing e comportamento de consumo no
              <a class="link-texto" href="https://marcelofreitas.substack.com/" rel="noopener">Substack</a>
              e no <a class="link-texto" href="/blog/">Blog da SAL</a>, que publica um artigo por dia sobre
              tráfego pago, SEO e operação de loja.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="malha"></div>
      <div class="wrap">
        <h2>Quer conversar sobre a sua operação?</h2>
        <p class="sub">
          O diagnóstico é conduzido pelo Marcelo. Trinta minutos, online, olhando as suas contas de
          anúncio, a sua presença no Google e a sua concorrência.
        </p>
        <a class="btn btn-primary" href="/agenda/">Agendar diagnóstico ↗</a>
        <div class="garantias">
          <span>Resposta em até 1 dia útil</span>
          <span>Diagnóstico sem custo</span>
          <span>Sem compromisso</span>
        </div>
      </div>
    </section>
  </main>

  <Rodape />
</Base>
