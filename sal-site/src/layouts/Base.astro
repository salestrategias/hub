---
import '../styles/tokens.css';
import '../styles/site.css';
import Cookies from '../components/Cookies.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: unknown;
  /** Fora do índice: usada só na página 404. */
  semIndice?: boolean;
}

const { title, description, canonical = Astro.url.pathname, schema, semIndice = false } = Astro.props;
const site = 'https://www.salestrategias.com.br';
const url = new URL(canonical, site).href;
const capa = site + '/img/og-sal.jpg';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content={semIndice ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />

  <meta property="og:site_name" content="SAL Estratégias de Marketing" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:image" content={capa} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="SAL Estratégias de Marketing: SEO e tráfego pago para loja física e e-commerce" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={capa} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
  <meta name="theme-color" content="#0B0A18" />

  <link rel="preload" href="/fonts/newsreader-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <script is:inline>document.body.classList.add('js')</script>
  <slot />

  <a class="zap" href="https://wa.me/5551993380278" rel="noopener" aria-label="Falar com a SAL no WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.6-4.5a8.4 8.4 0 1 1 15.4-4.4Z"/><path d="M9 9.4c.3 2.4 3.2 5.3 5.6 5.6.6.1 1.3-.5 1.4-1.1l-1.8-.9-.9.9c-1-.5-2.2-1.7-2.7-2.7l.9-.9-.9-1.8c-.6.1-1.2.8-1.1 1.4Z"/></svg>
  </a>
  <Cookies />

  <!-- Antes de abrir o WhatsApp, a pessoa se identifica. Filtra curioso e
       registra o contato no funil da SAL. -->
  <div class="zapgate" id="zapgate" hidden role="dialog" aria-modal="true" aria-labelledby="zapgate-titulo">
    <div class="zapgate-veu" data-zapgate-fecha></div>
    <div class="zapgate-cartao">
      <button type="button" class="zapgate-x" data-zapgate-fecha aria-label="Fechar">×</button>
      <h2 id="zapgate-titulo">Vamos conversar no WhatsApp?</h2>
      <p>Deixe seus dados para o nosso time saber com quem está falando. Leva dez segundos.</p>
      <form id="zapgate-form" novalidate>
        <label>Seu nome
          <input type="text" name="nome" autocomplete="name" placeholder="Nome completo" required />
        </label>
        <label>Seu WhatsApp
          <input type="tel" name="whatsapp" autocomplete="tel" placeholder="(51) 99999-9999" required />
        </label>
        <label>Seu e-mail
          <input type="email" name="email" autocomplete="email" placeholder="voce@suaempresa.com.br" required />
        </label>
        <label>Site ou Instagram do negócio
          <input type="text" name="site" autocomplete="url" placeholder="Se ainda não tiver, deixe em branco" />
        </label>
        <p class="zapgate-erro" id="zapgate-erro" hidden></p>
        <button type="submit" class="btn btn-primary">Abrir o WhatsApp ↗</button>
        <p class="zapgate-nota">Usamos esses dados só para o atendimento. Nada de lista de disparo.</p>
      </form>
    </div>
  </div>

  <script>import '../scripts/site.js';</script>
  <script>import '../scripts/cookies.js';</script>
  <script>import '../scripts/zap-gate.js';</script>
</body>
</html>
